{
  "name": "minecraft-title-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\" \"renderer/*.test.js\" && npm run test:vue2",
    "test:quick": "node --test \"test/**/*.test.js\"",
    "test:content": "node --test \"test/content/*.test.js\"",
    "test:lib": "node --test \"test/lib/*.test.js\"",
    "test:render": "node --test \"test/render/*.test.js\" \"renderer/*.test.js\"",
    "test:vue2": "node --import ./test/helpers/useVue2.js --test \"test/render/*.test.js\" test/lib/panels.test.js renderer/object-renderer.test.js",
    "test:server": "node --test \"test/server/*.test.js\"",
    "test:submissions": "node --test \"test/submissions/*.test.js\" \"test/generator/*.test.js\"",
    "test:app": "node --test \"test/app/*.test.js\" \"test/fontEditor/*.test.js\" \"test/site/*.test.js\"",
    "mark": "node generator/mark.js",
    "convert": "node generator/convert.js",
    "template": "node generator/template.js",
    "thumbnails": "node generator/thumbnails.js",
    "compress": "node generator/compress.js"
  },
  "dependencies": {
    "@countertype/clipper2-ts": "^1.5.4",
    "easy-tooltips-vue": "^1.1.0",
    "fluid-marquee-vue": "^1.0.0",
    "fluid-tabs-vue": "^1.0.1",
    "minecraft-asset-loader": "^1.6.0",
    "obscenity": "^0.4.6",
    "opentype.js": "^2.0.0",
    "three": "^0.187.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "woff2-encoder": "^2.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "pngjs": "^7.0.0",
    "vite": "^8.3.5",
    "vue2": "npm:vue@^2.7.16"
  },
  "optionalDependencies": {
    "optipng-bin": "^9.0.0"
  }
}
